# Copy to server/.env (dotenv loads from the server/ working directory, not the repo root).

# MongoDB connection string (Atlas or local)
MONGO_URL=mongodb://localhost:27017/workplace

# Secret used to sign and verify JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN=

# Cloudinary (profile photos) - https://cloudinary.com/console
CLOUDINARY_CLOUDNAME=
CLOUDINARY_APIKEY=
CLOUDINARY_APISECRET=

# Gmail account used to send transactional email.
# GMAIL_PASS must be a Google App Password, not the account password:
# https://support.google.com/accounts/answer/185833
GMAIL_USER=
GMAIL_PASS=
