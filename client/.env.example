# Copy to client/.env. Create React App only exposes variables prefixed REACT_APP_.

# API origin. Leave empty in development: calls go through the CRA proxy
# ("proxy" in package.json -> http://localhost:3001) so the auth cookie is same-origin.
REACT_APP_API_URL=

# Socket server for real-time chat
REACT_APP_SOCKET_URL=ws://localhost:8900
